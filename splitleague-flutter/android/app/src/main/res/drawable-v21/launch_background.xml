<?xml version="1.0" encoding="utf-8"?>
<!-- Customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#005F8A"
                android:endColor="#00B3A4"
                android:type="linear" />
        </shape>
    </item>

    <!-- Logo -->
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
