# The SplitLeague API this admin tool reads from.
#
# Locally that is your own copy of splitleague-server; in production it is the live API.
# No trailing slash.
SPLITLEAGUE_API_URL=http://localhost:3000

# Optional. Only needed if you would rather the admin password hash did not live in
# splitleague-server/routes/admin_login.js. Set both on the SERVER, not here.
#   ADMIN_EMAIL=
#   ADMIN_PASSWORD_HASH=
