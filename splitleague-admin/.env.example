# The SplitLeague API this admin tool reads from.
#
# Locally that is your own copy of splitleague-server; in production it is the live API.
# No trailing slash.
SPLITLEAGUE_API_URL=http://localhost:3000

# The admin credentials are NOT set here. They live in splitleague-server/.env, because it
# is the server that checks them:
#   ADMIN_EMAIL=
#   ADMIN_PASSWORD_HASH=      # bcrypt hash, not the password
