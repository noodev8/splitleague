# Flutter (splitleague-flutter)
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Runner.xcworkspace/

# Android
android/.gradle/
android/.idea/
android/local.properties
android/app/*.iml
android/key.properties

# Misc
*.iml
*.lock
# ...but pubspec.lock is committed. This is an application, not a package, so the
# exact resolved versions are part of the build. It matters more than usual here:
# flutter_secure_storage must stay on v10, because v11 cannot read the JWT that v9
# wrote and would silently log every existing user out.
!pubspec.lock
.idea/

# =========================================
# Environment files
.env
*.env
splitleague-server/.env

